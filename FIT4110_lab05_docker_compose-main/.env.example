# API configuration
APP_HOST=0.0.0.0
APP_PORT=8000
AI_PORT=9000
AUTH_TOKEN=local-dev-token
SERVICE_NAME=iot-ingestion
SERVICE_VERSION=0.5.0
ENV=local
DEVICE_REGISTRY_PATH=/app/data/IoT_device_registry.csv

# Database configuration
POSTGRES_USER=lab05
POSTGRES_PASSWORD=lab05pass
POSTGRES_DB=iotdb

# MQTT/HiveMQ configuration (put real credentials only in local .env)
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_INPUT_TOPIC=smart-campus/raw/iot/environment
MQTT_OUTPUT_TOPIC=smart-campus/events/sensor
MQTT_CLIENT_ID=iot-ingestion-lab05

# Analytics MQTT broker (anonymous)
ANALYTICS_ENABLED=false
ANALYTICS_HOST=192.168.1.51
ANALYTICS_PORT=1883
ANALYTICS_TOPIC=iot.telemetry
ANALYTICS_CLIENT_ID=iot-ingestion-analytics

# Core Business event receiver
CORE_ENABLED=false
CORE_EVENTS_URL=http://192.168.1.61:8001/events
CORE_ASYNC_ENABLED=false
CORE_MQTT_HOST=192.168.1.51
CORE_MQTT_PORT=1883
CORE_MQTT_TOPIC=campus.sensors
CORE_MQTT_CLIENT_ID=iot-ingestion-core